# Copia este archivo como .env.local y ajústalo. No subas .env.local al repo.

# URL del backend de Django, sin barra al final.
VITE_API_URL=http://localhost:8000

# De dónde lee el panel:
#   mock → datos de muestra en memoria (no necesita backend)
#   api  → todo contra /api/v1/admin/ del backend
VITE_DATOS=mock

# Con VITE_DATOS=mock, secciones que igual van contra la API (separadas por coma).
# Sirve para conectar una pantalla a la vez a medida que existen los endpoints.
# Secciones: sesion, resumen, usuarios, polizas, retroactivo, objetivos, reglas, cierres, bitacora,
#            premios, cupones, liga, patrocinios
VITE_DATOS_API=
